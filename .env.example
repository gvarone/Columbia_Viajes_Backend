# Copiá este archivo como .env y completá tus valores.
# .env está en .gitignore: nunca se sube al repositorio.

# Conexión a MySQL (URL y usuario tienen valor por defecto en application.properties)
DB_URL=jdbc:mysql://localhost:3307/columbia_viajes
DB_USERNAME=root
DB_PASSWORD=

# Clave para firmar los JWT: Base64 de al menos 32 bytes aleatorios.
# Linux/macOS: openssl rand -base64 32
JWT_SECRET=
